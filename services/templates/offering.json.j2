{
  "name": "{{ offering_name }}",
  "display_name": "{{ display_name }}",
{#- The validator requires >=2 paragraphs separated by a blank line, and the
    first (the collapsed list-view teaser) must be under 200 chars. The populate
    script supplies only a one-line brief, so compose the rest here. Keep the
    model's own blurb as the teaser when it fits; otherwise use a short generated
    teaser and move the full blurb into a later paragraph. #}
{%- set _about = description | default('', true) %}
{%- set _short = _about and _about | length < 200 and '\n\n' not in _about %}
{%- set _teaser_base = _about if _short else (display_name ~ ' — served by ' ~ provider_display_name ~ ' through the UnitySVC gateway.') %}
{#- The teaser is the only paragraph shown collapsed, so it carries the
    dual-dialect differentiator — but ONLY for cloud services: the byoe
    channel has no llm_translator, so the claim would be false there. #}
{%- set _teaser_dual = _teaser_base ~ ' Callable in both OpenAI and Anthropic API styles.' %}
{%- set _teaser = _teaser_dual if (in_ollama_cloud and (_teaser_dual | length) < 195) else _teaser_base %}
{%- set _ctx = ' with a ' ~ details.context_length ~ '-token context window' if details and details.context_length else '' %}
{%- if in_ollama_cloud %}
{%- set _detail = display_name ~ ' is served over an OpenAI-compatible API' ~ _ctx ~ '. Through the UnitySVC gateway you can run it on Ollama Cloud with your own Ollama API key (byok channel), or route to your own Ollama server (byoe channel). See the code examples for both API styles.' %}
{%- set _interop = 'One endpoint, either dialect — send an OpenAI Chat Completions or an Anthropic Messages request and the gateway auto-detects the format, translates it for the upstream, and replies in the style you sent. Because every model on UnitySVC speaks both dialects, they are interchangeable behind a single client: swap providers without touching your code, and combine them with the gateway composition primitives — group (/g/), broadcast (/b/), chain (/c/) and failover (/f/).' %}
{%- else %}
{%- set _interop = '' %}
{%- set _detail = display_name ~ ' is served over an OpenAI-compatible API' ~ _ctx ~ '. Route it through the UnitySVC gateway to your own Ollama server using the bring-your-own-endpoint (byoe) channel, then call it with the OpenAI-compatible code examples below.' %}
{%- endif %}
{%- set _description = _teaser ~ (('\n\n' ~ _about) if (_about and not _short) else '') ~ '\n\n' ~ _detail ~ (('\n\n' ~ _interop) if _interop else '') %}
  "description": {{ _description | tojson }},
  "service_type": "{{ service_type }}",
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  "tags": {{ tags | tojson }},
{%- if capabilities %}
  "capabilities": {{ capabilities | tojson }},
{%- endif %}
{%- if in_ollama_cloud %}
  {#- R8: the cloud byok channel carries the anthropic->openai translator,
      so advertise both request/response dialects. #}
  "details": {{ dict(details or {}, input_formats=["openai", "anthropic"], output_formats=["openai_response", "anthropic_response"]) | tojson }},
{%- else %}
  "details": {{ details | tojson }},
{%- endif %}
  "upstream_access_config": {
    "byoe": {
      "access_method": "http",
      "base_url": "{{ '{{ params.base_url }}' }}",
      "rate_limits": [],
      "routing_key": {
        "model": "{{ ops_testing_model }}"
      },
      "sort_order": 3
    }{% if in_ollama_cloud %},
    "byok": {
      "access_method": "http",
      "api_key": "${ customer_secrets.OLLAMA_API_KEY }",
      "base_url": "https://ollama.com",
      "rate_limits": [],
      "routing_key": {
        "model": "{{ cloud_model }}"
      },
      "request_transformer": {
        "llm_translator": "anthropic_to_openai"
      },
      "sort_order": 2
    }{% endif %}
  }
}
