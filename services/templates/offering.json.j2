{
{#- Model-family logo (unitysvc/unitysvc-data#60): the catalog row shows the
    model's own mark rather than the provider's — the model is what a customer
    recognises, and the provider is already named beside it. Resolved from the
    model id, so no per-model parameter is needed and the populate script
    cannot destroy it. A model the registry does not know resolves to null,
    which creates no document and leaves the provider logo in place, so the key
    needs no conditional. -#}
  "logo": {{ {"$logo_preset": offering_name} | tojson }},
  "name": "{{ offering_name }}",
  "display_name": "{{ display_name }}",
{#- Marketplace copy (unitysvc/unitysvc#1838): the collapsed list-view teaser
    now lives in the required `summary` field (max 200 chars); `description`
    holds the long-form paragraphs. The populate script supplies only a
    one-line brief, so compose the rest here. Keep the model's own blurb as
    the teaser when it fits; otherwise use a short generated teaser and keep
    the full blurb in the description. #}
{%- set _about = description | default('', true) %}
{%- set _short = _about and _about | length < 200 and '\n\n' not in _about %}
{%- set _teaser_base = _about if _short else (display_name ~ ' — served by ' ~ provider_display_name ~ ' through the UnitySVC gateway.') %}
{#- The teaser is the only paragraph shown collapsed, so it carries the
    dual-dialect differentiator — but ONLY for cloud services: the byoe
    channel has no llm_translator, so the claim would be false there. #}
{%- set _teaser_dual = _teaser_base ~ ' Callable in both OpenAI and Anthropic API styles.' %}
{%- set _teaser = _teaser_dual if (in_ollama_cloud and (_teaser_dual | length) < 195) else _teaser_base %}
{%- set _ctx = ' with a ' ~ details.context_length ~ '-token context window' if details and details.context_length else '' %}
{%- if in_ollama_cloud %}
{%- set _detail = display_name ~ ' is served over an OpenAI-compatible API' ~ _ctx ~ '. Through the UnitySVC gateway you can run it on Ollama Cloud with your own Ollama API key (byok channel), or route to your own Ollama server (byoe channel). See the code examples for both API styles.' %}
{%- set _interop = 'One endpoint, either dialect — send an OpenAI Chat Completions or an Anthropic Messages request and the gateway auto-detects the format, translates it for the upstream, and replies in the style you sent. Because every model on UnitySVC speaks both dialects, they are interchangeable behind a single client: swap providers without touching your code, and combine them with the gateway composition primitives — group (/g/), broadcast (/b/), chain (/c/) and failover (/f/).' %}
{%- else %}
{%- set _interop = '' %}
{%- set _detail = display_name ~ ' is served over an OpenAI-compatible API' ~ _ctx ~ '. Route it through the UnitySVC gateway to your own Ollama server using the bring-your-own-endpoint (byoe) channel, then call it with the OpenAI-compatible code examples below.' %}
{%- endif %}
{%- set _description = ((_about ~ '\n\n') if (_about and not _short) else '') ~ _detail ~ (('\n\n' ~ _interop) if _interop else '') %}
  "summary": {{ (_teaser | trim)[:200] | tojson }},
  "description": {{ _description | tojson }},
  "service_type": "{{ service_type }}",
{#- Model-family logo (unitysvc/unitysvc#1858). Resolved from the model id by
    the shared registry in unitysvc-data, so `ollama/qwen3-coder` shows the Qwen
    mark rather than Ollama's. Lives here rather than in the param files because
    update_params.py rewrites everything under specs/ on every populate run.
    An unrecognised model resolves to null, which creates no document and leaves
    the provider logo in place — hence no conditional around the key. #}
  "logo": {{ {"$logo_preset": offering_name} | tojson }},
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
{#- Closed vocabulary (unitysvc docs/tags.yml): `feature:func-call` or nothing.
    update_params.py sets this from Ollama's own "tools" library badge. Emitted
    only when non-empty so an untagged model renders no `tags` key at all
    rather than an empty list. -#}
{%- if tags %}
  "tags": {{ tags | tojson }},
{%- endif %}
{#- Platform capability vocabulary (unitysvc docs/capabilities.yml) — always
    present now. Ollama's own library badges (tools / vision / thinking /
    audio) are attributes, not capabilities, and live in
    `details.ollama_badges`. The map here is the fallback for a param file
    written before the populator emitted the vocabulary value. -#}
{%- set _cap = {"llm": "chat", "embedding": "embed"}.get(service_type, "chat") %}
  "capabilities": {{ capabilities | default([_cap], true) | tojson }},
{%- if in_ollama_cloud %}
  {#- R8: the cloud byok channel carries the anthropic->openai translator,
      so advertise both request/response dialects. #}
  "details": {{ dict(details or {}, input_formats=["openai", "anthropic"], output_formats=["openai_response", "anthropic_response"]) | tojson }},
{%- else %}
  "details": {{ details | tojson }},
{%- endif %}
  "upstream_access_config": {
    "byoe": {
      "access_method": "http",
      "base_url": "{{ '{{ params.base_url }}' }}",
      "rate_limits": [],
      "routing_key": {
        "model": "{{ ops_testing_model }}"
      },
      "sort_order": 3
    }{% if in_ollama_cloud %},
    "byok": {
      "access_method": "http",
      "api_key": "${ customer_secrets.OLLAMA_API_KEY }",
      "base_url": "https://ollama.com",
      "rate_limits": [],
      "routing_key": {
        "model": "{{ cloud_model }}"
      },
      "request_transformer": {
        "llm_translator": "anthropic_to_openai"
      },
      "sort_order": 2
    }{% endif %}
  }
}
