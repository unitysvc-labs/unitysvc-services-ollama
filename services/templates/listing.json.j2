{
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  "name": "{{ provider_name }}/{{ offering_name }}",
  {#- Per-channel price copy follows the marketplace description grammar
      (unitysvc/unitysvc#1886, PR #1887):

          <amount> [ ~<intent> <PILL> ] [ | <hover note> ]

      Both channels cost nothing at the gateway, but for different reasons, and
      the reason is the useful half of the cell — so it rides the badge slot and
      renders as a pill beside the amount rather than as a run-on sentence. The
      two reasons are distinct platform access methods, not synonyms (see
      `AccessMethod` in frontend/lib/service-utils.ts): `byoe` is bring-your-own
      ENDPOINT — you point the gateway at a server you already run, and there is
      no upstream bill at all; `byok` is bring-your-own-KEY — Ollama Cloud runs
      the model and bills your own Ollama account. Labelling both "BYOK" would
      collapse that difference.

      A bare `~` selects the default intent (a saving — green fill); `~deal` /
      `~coupon` / `~info` are the other registers. The routing prose moves behind
      `|`, which is taken first and consumed to end-of-string, so everything in
      it is inert and never re-parsed as a unit.

      Note the previous copy used an ASCII hyphen ("Free - route to …"), which is
      deliberately NOT a separator in the grammar — it protects copy like
      "Free - $0.001" — so it rendered as one unstyled line. #}
  "list_price": {
    "type": "channel",
    "default": "byoe",
    "channels": {
      "byoe": {
        "description": "Free ~ BYOE | route to your own Ollama-compatible endpoint",
        "price": "0",
        "type": "constant"
      }{% if in_ollama_cloud %},
      "byok": {
        "description": "Free ~ BYOK | route to Ollama Cloud using your own Ollama API key",
        "price": "0",
        "type": "constant"
      }{% endif %}
    }
  },
  "user_access_interfaces": {
    "canonical": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/ollama",
      "routing_key": {
        "model": "{{ ops_testing_model }}"
      }
    }
  },
  "user_parameters_schema": {
    "type": "object",
    "title": "Ollama Endpoint Configuration",
    "description": "Provide a public URL for your Ollama server for the BYOE channel",
    "required": ["base_url"],
    "properties": {
      "base_url": {
        "type": "string",
        "title": "Public Ollama Server URL",
        "default": "https://ollama.example.com",
        "description": "Public base URL of your Ollama server. The UnitySVC gateway must be able to reach this DNS name or IP address over the network."
      }
    }
  },
  "user_parameters_ui_schema": {
    "base_url": {
      "ui:placeholder": "https://ollama.example.com",
      "ui:description": "A public DNS name or IP address that routes to your Ollama server"
    }
  },
  "service_options": {
    "ops_testing_parameters": {
      "base_url": "https://mock.unitysvc.dev/openai"
    }
  },
  "documents": {
    "How to use this model": {
      "category": "getting_started",
      "file_path": "description.md.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "markdown"
    },
{%- if service_type == "embedding" %}
    {#- BYOE routes to customer-supplied infrastructure, so the platform cannot
        prove it with catalog tests. BYOE-only services keep examples visible
        but skipped; if an embedding model later gains Ollama Cloud, executable
        docs scope to that byok channel. -#}
    "$llm_example_collection": {
      "capabilities": ["embed"],
      "formats": [
        {
          "formats": ["openai"],
{%- if in_ollama_cloud %}
          "channel": "byok",
          "interface": "canonical",
          "primary": true
{%- else %}
          "test_status": "skip"
{%- endif %}
        }
      ]
    }
  }
}
{%- else %}
    {#- Ollama always exposes BYOE, but BYOE should not be tested: it depends on
        a customer's own endpoint. Cloud-backed services run examples/probes on
        byok; BYOE-only services emit skipped examples. The ollama-python entry
        remains as a repo-specific sibling because the shared collection cannot
        derive that SDK flavour. -#}
    "$llm_example_collection": {
      "capabilities": ["chat"],
      "formats": [
        {
{%- if in_ollama_cloud %}
          "formats": ["openai", "anthropic"],
          "channel": "byok",
          "interface": "canonical",
          "primary": true
{%- else %}
          "formats": ["openai"],
          "test_status": "skip"
{%- endif %}
        }
      ],
      "upstream_dialect": "openai"
    },
    "Python ollama-python code example": {
      "category": "code_example",
      "description": "Example code using the ollama-python library",
      "file_path": "code-example-ollama.py.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "python",
      "meta": {"test": {"status": "skip"}}
    }
  }
}
{%- endif %}
